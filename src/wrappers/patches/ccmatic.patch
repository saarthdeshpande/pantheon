+++ b/ccmatic_policy.hh
@@ -0,0 +1,46 @@
+#ifndef CCMATICPOLICY_HH
+#define CCMATICPOLICY_HH
+
+#include <string>
+
+#include "slow_conv.hh"
+
+// The five CCmatic (NSDI'24) Listing 2 policies on top of the authors'
+// belief framework (SlowConv). cc_qdel and cc_probe_slow reuse the authors'
+// FastConv/SlowConv rate rules unchanged; the other three are Listing 2
+// transcribed. set_policy() allows switching at runtime.
+class CcmaticPolicy : public SlowConv {
+   public:
+	enum Policy { CC_QDEL, CC_PROBE_FAST, CC_PROBE_DRAIN, CC_PROBE_SLOW, CC_PROBE_QDEL };
+
+	static bool parse_policy(const std::string &name, Policy &out);
+
+	CcmaticPolicy(Policy policy, std::string logfilepath = "")
+		: SlowConv(logfilepath), policy(policy) {
+		apply_policy_state();
+	}
+
+	// Runtime selection interface (for future policy-switching controllers).
+	void set_policy(Policy p) {
+		policy = p;
+		apply_policy_state();
+	}
+	Policy get_policy() const { return policy; }
+
+	void init() override {
+		SlowConv::init();
+		apply_policy_state();
+	}
+
+   protected:
+	void update_state(Time now, const SegmentData &seg) override;
+	void update_rate_cwnd_slow_conv(Time now) override;
+
+   private:
+	Policy policy;
+	// cc_qdel and cc_probe_slow start in SLOW_START (authors' cc_qdel);
+	// the three probe policies always run their Listing 2 rule.
+	void apply_policy_state();
+};
+
+#endif
