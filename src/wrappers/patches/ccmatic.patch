new file mode 100644
index 0000000..be9cef9
--- /dev/null
+++ b/ccmatic_policy.cc
@@ -0,0 +1,60 @@
+#include "ccmatic_policy.hh"
+
+bool CcmaticPolicy::parse_policy(const std::string &name, Policy &out) {
+	if (name == "cc_qdel") out = CC_QDEL;
+	else if (name == "cc_probe_fast") out = CC_PROBE_FAST;
+	else if (name == "cc_probe_drain") out = CC_PROBE_DRAIN;
+	else if (name == "cc_probe_slow") out = CC_PROBE_SLOW;
+	else if (name == "cc_probe_qdel") out = CC_PROBE_QDEL;
+	else return false;
+	return true;
+}
+
+void CcmaticPolicy::apply_policy_state() {
+	bool probe_rule = policy == CC_PROBE_FAST || policy == CC_PROBE_DRAIN ||
+					  policy == CC_PROBE_QDEL;
+	state = probe_rule ? State::CONG_AVOID : State::SLOW_START;
+}
+
+void CcmaticPolicy::update_state(Time now, const SegmentData &seg) {
+	// Only cc_probe_slow leaves SLOW_START (cc_qdel) after repeated large loss.
+	if (policy == CC_PROBE_SLOW) SlowConv::update_state(now, seg);
+}
+
+void CcmaticPolicy::update_rate_cwnd_slow_conv(Time now) {
+	if (policy == CC_PROBE_SLOW) {
+		SlowConv::update_rate_cwnd_slow_conv(now);
+		return;
+	}
+
+	// Beliefs, in segs/s (rates) and ms (times).
+	const SegsRate CL = beliefs.min_c;
+	const SegsRate CU = beliefs.max_c;
+	const TimeDelta qdelL = beliefs.min_qdel;
+	const TimeDelta Rm = beliefs.min_rtt;
+	const SegsRate alphaR = MS_TO_SECS / Rm;  // MSS/Rm
+
+	SegsRate rate = CL;
+	switch (policy) {
+		case CC_PROBE_FAST:
+			rate = (CU < 2 * CL) ? CL : 2 * CL;
+			break;
+		case CC_PROBE_DRAIN:
+			rate = (CU > 2 * CL - 2 * alphaR) ? 2 * CL + alphaR : CL - alphaR;
+			break;
+		case CC_PROBE_QDEL:
+			if (CU < 1.5 * CL)
+				rate = (qdelL > Rm) ? alphaR : CL;
+			else
+				rate = (CU > 2 * CL) ? 2 * CL + alphaR : CL;
+			break;
+		default:
+			break;
+	}
+	sending_rate = std::max(rate, alphaR);  // Listing 1, line 7
+
+	// Same window cap as the authors' policies.
+	cwnd = (2 * beliefs.max_c * (Rm + Rm * JITTER_MULTIPLIER)) / MS_TO_SECS;
+	_intersend_time = MS_TO_SECS / sending_rate;
+	_the_window = cwnd;
+}
diff --git a/ccmatic_policy.hh b/ccmatic_policy.hh
new file mode 100644
